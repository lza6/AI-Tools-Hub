{
  "name": "ai-tools-hub",
  "version": "1.5.0",
  "description": "你的AI军火库 - CLI 工具 / MCP / 技能 / Hook 一站式安装与更新",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.lza6.ai-tools-hub",
    "productName": "AI-Tools-Hub",
    "files": [
      "electron/**/*",
      "src/**/*",
      "registry/**/*",
      "assets/logo-256.png",
      "assets/logo-512.png",
      "assets/icon.ico"
    ],
    "mac": {
      "icon": "assets/logo-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/logo-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "lza6",
      "repo": "AI-Tools-Hub"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lza6/AI-Tools-Hub.git"
  },
  "keywords": [
    "ai",
    "mcp",
    "cli",
    "skills",
    "marketplace"
  ],
  "author": {
    "name": "lza6",
    "email": "lza6@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lza6/AI-Tools-Hub/issues"
  },
  "homepage": "https://github.com/lza6/AI-Tools-Hub#readme",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
