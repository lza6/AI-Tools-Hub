      "capabilities": ["跨会话持久记忆", "语义搜索召回", "memoir 知识图谱", "会话转录归档", "记忆健康审计"],
      "solves": "AI 会话结束即失忆；icm 让每个项目拥有可搜索、可整理的长期记忆库。",
      "homepage": "https://github.com/rtk-ai/icm",
      "install": {
        "type": "ps1",
        "url": "https://raw.githubusercontent.com/rtk-ai/icm/main/install.ps1",
        "oneLiner": "irm https://raw.githubusercontent.com/rtk-ai/icm/main/install.ps1 | iex"
      },
      "versionCmd": "icm --version",
      "detectCmd": "where.exe icm",
      "skills": [
        {
          "name": "ICM 集成（Claude Code 记忆协议）",
          "agents": ["claude-code"],
          "installCmd": "icm init",
          "description": "将 icm 记忆协议注入 CLAUDE.md，自动召回/存储记忆"
        }
      ]
    },
    {
      "id": "rtk",
      "name": "RTK",
      "fullName": "RTK CLI Proxy",
      "repo": "rtk-ai/rtk",
      "description": "高性能 CLI 代理：在输出进入 LLM 上下文前过滤和压缩（git/gh/docker/kubectl/grep 等数十个命令的 token 优化输出）。",
      "capabilities": ["token 优化输出", "git/gh/docker/kubectl 代理", "日志去重过滤", "JSON 结构提取", "敏感信息掩码"],
      "solves": "命令输出吃掉大量上下文 token；rtk 压缩 50-90%，让 agent 跑得更远更省。",
      "homepage": "https://github.com/rtk-ai/rtk",
      "install": {
        "type": "ps1",
        "url": "https://raw.githubusercontent.com/rtk-ai/rtk/main/install.ps1",
        "oneLiner": "irm https://raw.githubusercontent.com/rtk-ai/rtk/main/install.ps1 | iex"
      },
      "versionCmd": "rtk --version",
      "detectCmd": "where.exe rtk",
      "skills": [
        {
          "name": "RTK 集成（CLAUDE.md 指令注入）",
          "agents": ["claude-code", "codex"],
          "installCmd": "rtk init",
          "description": "将 rtk 使用指令写入 CLAUDE.md，让 agent 优先走 rtk 压缩命令"
        }
      ]
    }
